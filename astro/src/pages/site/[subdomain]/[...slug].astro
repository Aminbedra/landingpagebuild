---
// Published landing page renderer. Path-based stand-in for real subdomain
// routing (Phase 4): /site/{subdomain}/{slug} today, {subdomain}.landingpagebuild.com/{slug}
// later — only the routing layer changes, this template stays the same.
//
// Astro rejects an optional catch-all ([[...slug]]) nested under another
// dynamic segment ("rest parameter must be a standalone segment"), so the
// slug is required here — a site's home page is requested explicitly as
// /site/{subdomain}/index rather than /site/{subdomain}.
export const prerender = false

import { env } from 'cloudflare:workers'
import Layout from '../../../layouts/Layout.astro'
import SectionRenderer from '../../../components/SectionRenderer.astro'
import ChatWidget from '../../../components/ChatWidget'
import { getPageFromKV } from '../../../lib/kv'

const { subdomain, slug } = Astro.params as { subdomain: string; slug: string }
const resolvedSlug = slug && slug.length > 0 ? slug : 'index'

const record = await getPageFromKV(env.KV, subdomain, resolvedSlug)

const apiUrl = import.meta.env.PUBLIC_WORKER_API_URL

if (!record) {
  Astro.response.status = 404
}
---

<Layout
  title={record ? `${record.page.name} — ${record.website.name}` : 'Page not found'}
  description={record?.website.description ?? undefined}
>
  {
    record ? (
      <>
        <main>
          <SectionRenderer
            sections={record.page.content.sections}
            websiteId={record.website.id}
            pageId={record.page.id}
            apiUrl={apiUrl}
          />
        </main>
        <ChatWidget client:idle websiteId={record.website.id} pageId={record.page.id} apiUrl={apiUrl} />
      </>
    ) : (
      <main class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center px-6 text-center">
        <h1 class="text-4xl font-bold text-slate-900">Page not found</h1>
        <p class="mt-3 text-slate-600">This site or page hasn&rsquo;t been published yet.</p>
      </main>
    )
  }
</Layout>
