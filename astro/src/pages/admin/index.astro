---
// No server-side data fetching here — all data loads client-side via the
// Worker API (astro/src/lib/adminAuth.ts). Auth is the existing internal
// JWT (Bearer token via POST /auth/login), not Cloudflare Access — see
// worker/src/routes/admin.ts for why.
//
// This page doesn't reuse ../../layouts/Layout.astro on purpose: that
// layout is themed for the public marketing site (light background) and
// isn't a fit for the admin panel's dark, full-height shell.
import '../../styles/global.css'
import AdminApp from '../../components/admin/AdminApp'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin — LandingPageBuild</title>
  </head>
  <body class="h-screen overflow-hidden bg-gray-950 text-gray-100">
    <div id="admin-root" class="h-full">
      <AdminApp client:load />
    </div>
  </body>
</html>
