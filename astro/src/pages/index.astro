---
import Layout from '../layouts/Layout.astro'
---

<Layout title="LandingPageBuild — Astro renderer">
  <main class="mx-auto max-w-2xl px-6 py-24">
    <h1 class="text-3xl font-bold text-slate-900">Astro SSR renderer</h1>
    <p class="mt-4 text-slate-600">
      Published pages render at <code class="rounded bg-slate-100 px-1.5 py-0.5 text-sm">/site/[subdomain]/[slug]</code>,
      pulling page copy from Workers KV at request time. Real subdomain-based routing (e.g. acme.landingpagebuild.com)
      lands in Phase 4 — this path-based route exists for local/staging testing until then.
    </p>
    <p class="mt-4">
      <a class="font-medium text-slate-900 underline" href="/site/demo/index">View the demo page →</a>
    </p>
  </main>
</Layout>
