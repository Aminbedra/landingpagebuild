---
import Layout from '../layouts/Layout.astro'
Astro.response.status = 404
---

<Layout title="Page not found">
  <main class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center px-6 text-center">
    <h1 class="text-4xl font-bold text-slate-900">404</h1>
    <p class="mt-3 text-slate-600">We couldn&rsquo;t find that page.</p>
    <a href="/" class="mt-6 font-medium text-slate-900 underline">Back home</a>
  </main>
</Layout>
