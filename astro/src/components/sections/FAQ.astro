---
interface FaqItem {
  question?: string
  answer?: string
}
interface Props {
  content: Record<string, any>
}
const { content } = Astro.props
const headline = content.headline ?? content.title ?? 'Frequently asked questions'
const items: FaqItem[] = content.items ?? []
---

<section class="mx-auto max-w-3xl px-6 py-20">
  <h2 class="text-3xl font-bold text-slate-900">{headline}</h2>
  <div class="mt-8 divide-y divide-slate-200">
    {
      items.map((item) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between text-left font-medium text-slate-900">
            {item.question}
            <span class="ml-4 text-slate-400 transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-slate-600">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
